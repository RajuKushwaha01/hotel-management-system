<div style="font-family: Arial, sans-serif; max-width: 500px; margin: auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
  <div style="background: linear-gradient(135deg, #0F172A, #111827); padding: 32px; text-align: center;">
    <h1 style="color: #C9A227; margin: 0;">Booking Confirmed ✓</h1>
  </div>
  <div style="padding: 32px;">
    <p style="color: #64748B;">Hi {{firstName}}, your reservation is confirmed!</p>
    <table style="width: 100%; margin-top: 16px; color: #0F172A;">
      <tr><td style="padding: 6px 0; color: #64748B;">Room</td><td style="text-align: right;">{{roomType}} — {{roomNumber}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B;">Check-in</td><td style="text-align: right;">{{checkIn}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B;">Check-out</td><td style="text-align: right;">{{checkOut}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B; font-weight: 600;">Total</td><td style="text-align: right; font-weight: 600;">₹{{totalAmount}}</td></tr>
    </table>
    <p style="color: #94A3B8; font-size: 12px; margin-top: 24px;">Booking ID: {{bookingId}}</p>
  </div>
</div>