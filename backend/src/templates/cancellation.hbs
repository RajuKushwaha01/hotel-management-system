<div style="font-family: Arial, sans-serif; max-width: 500px; margin: auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
  <div style="background: linear-gradient(135deg, #0F172A, #111827); padding: 32px; text-align: center;">
    <h1 style="color: #EF4444; margin: 0;">Booking Cancelled</h1>
  </div>
  <div style="padding: 32px;">
