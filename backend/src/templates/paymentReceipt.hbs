<div style="font-family: Arial, sans-serif; max-width: 500px; margin: auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
  <div style="background: linear-gradient(135deg, #0F172A, #111827); padding: 32px; text-align: center;">
    <h1 style="color: #10B981; margin: 0;">Payment Received ✓</h1>
  </div>
  <div style="padding: 32px;">
    <p style="color: #64748B;">Hi {{firstName}}, we've received your payment.</p>
    <table style="width: 100%; margin-top: 16px; color: #0F172A;">
      <tr><td style="padding: 6px 0; color: #64748B;">Amount</td><td style="text-align: right; font-weight: 600;">₹{{amount}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B;">Method</td><td style="text-align: right;">{{method}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B;">Date</td><td style="text-align: right;">{{date}}</td></tr>
    </table>
  </div>
</div>