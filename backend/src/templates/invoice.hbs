<div style="font-family: Arial, sans-serif; max-width: 500px; margin: auto; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden;">
  <div style="background: linear-gradient(135deg, #0F172A, #111827); padding: 32px; text-align: center;">
    <h1 style="color: #C9A227; margin: 0;">Your Invoice</h1>
  </div>
  <div style="padding: 32px;">
    <p style="color: #64748B;">Hi {{firstName}}, your invoice is ready.</p>
    <table style="width: 100%; margin-top: 16px; color: #0F172A;">
      <tr><td style="padding: 6px 0; color: #64748B;">Total Charges</td><td style="text-align: right;">₹{{totalCharges}}</td></tr>
      <tr><td style="padding: 6px 0; color: #64748B;">Total Paid</td><td style="text-align: right;">₹{{totalPaid}}</td></tr>
      <tr><td style="padding: 6px 0; color: #0F172A; font-weight: 600;">Balance</td><td style="text-align: right; font-weight: 600;">₹{{balance}}</td></tr>
    </table>
    <p style="color: #94A3B8; font-size: 12px; margin-top: 24px;">View and download the full invoice from your dashboard.</p>
  </div>
</div>